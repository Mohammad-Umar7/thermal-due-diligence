# FortyGuard Temperature API
# Generate at https://dashboard.fortyguard.com/login -> Profile (bottom-left) -> generate key
FORTYGUARD_API_KEY=
FORTYGUARD_BASE_URL=https://api.fortyguard.com/v1

# Postgres (Supabase or Neon) - cached API responses and computed reports
DATABASE_URL=

# Geocoding (US Census Geocoder is keyless; set only if using a fallback provider)
GEOCODER_PROVIDER=census

# Set to 1 to run entirely from recorded fixtures with zero live API calls
FORTYGUARD_FIXTURES_ONLY=0
